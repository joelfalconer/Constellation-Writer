{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CWTauriShellSpike",
  "version": "0.0.1",
  "identifier": "com.constellation.writer.shellspike.tauri",
  "build": {
    "frontendDist": "../../shared/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Constellation Writer Tauri Shell Spike",
        "width": 1100,
        "height": 760,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true
  }
}
