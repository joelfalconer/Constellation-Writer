{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation-writer.local/contracts/compendium/claim.schema.json",
  "title": "Compendium Claim",
  "type": "object",
  "required": ["id", "schema_version", "type", "canon_state", "confidence", "statement", "subject_entity_id", "evidence_ids", "created_at", "modified_at"],
  "properties": {
    "id": {"$ref": "../common/identifier.schema.json#/$defs/ClaimId"},
    "schema_version": {"type": "string"},
    "type": {"enum": ["attribute", "event", "location", "relation", "timeline", "appearance", "rule", "motif", "publication", "contradiction", "custom"]},
    "canon_state": {"$ref": "../common/lifecycle.schema.json#/$defs/CanonState"},
    "confidence": {"enum": ["manual", "observed", "inferred", "imported", "uncertain"]},
    "statement": {"type": "string"},
    "subject_entity_id": {"$ref": "../common/identifier.schema.json#/$defs/EntityId"},
    "predicate": {"type": "string"},
    "object": {},
    "evidence_ids": {"type": "array", "items": {"$ref": "../common/identifier.schema.json#/$defs/EvidenceId"}},
    "created_at": {"$ref": "../common/timestamp.schema.json#/$defs/Instant"},
    "modified_at": {"$ref": "../common/timestamp.schema.json#/$defs/Instant"}
  },
  "additionalProperties": true
}
