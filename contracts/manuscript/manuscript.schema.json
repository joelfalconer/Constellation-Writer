{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://constellation-writer.local/contracts/manuscript/manuscript.schema.json",
  "title": "Manuscript Manifest",
  "type": "object",
  "required": ["id", "schema_version", "project_id", "title", "kind", "root_nodes"],
  "properties": {
    "id": {"$ref": "../common/identifier.schema.json#/$defs/ManuscriptId"},
    "schema_version": {"type": "string"},
    "project_id": {"$ref": "../common/identifier.schema.json#/$defs/ProjectId"},
    "title": {"type": "string"},
    "kind": {"enum": ["novel", "nonfiction_book", "essay", "essay_collection", "article", "screenplay", "poetry_collection", "research_report", "editorial_package", "serial", "anthology", "excerpt", "custom"]},
    "root_nodes": {"type": "array", "items": {"$ref": "#/$defs/Node"}}
  },
  "$defs": {
    "Node": {
      "type": "object",
      "required": ["id", "type", "title", "include", "role", "children"],
      "properties": {
        "id": {"$ref": "../common/identifier.schema.json#/$defs/PlacementId"},
        "type": {"enum": ["sheet_ref", "container", "generated", "asset_ref", "placeholder"]},
        "sheet_id": {"$ref": "../common/identifier.schema.json#/$defs/SheetId"},
        "title": {"type": "string"},
        "include": {"oneOf": [{"type": "boolean"}, {"const": "inherit"}]},
        "role": {"type": "string"},
        "title_behavior": {"enum": ["manifest_title", "sheet_title", "first_heading", "generated", "suppress", "inherit"]},
        "children": {"type": "array", "items": {"$ref": "#/$defs/Node"}}
      },
      "allOf": [{"if": {"properties": {"type": {"const": "sheet_ref"}}}, "then": {"required": ["sheet_id"]}}],
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
