      {"$ref": "#/$defs/ProjectId"}, {"$ref": "#/$defs/SheetId"}, {"$ref": "#/$defs/ManuscriptId"}, {"$ref": "#/$defs/PlacementId"}, {"$ref": "#/$defs/RevisionId"}, {"$ref": "#/$defs/EntityId"}, {"$ref": "#/$defs/ClaimId"}, {"$ref": "#/$defs/EvidenceId"}, {"$ref": "#/$defs/OperationId"}, {"$ref": "#/$defs/PatchSessionId"}, {"$ref": "#/$defs/PatchId"}, {"$ref": "#/$defs/SnapshotId"}, {"$ref": "#/$defs/ConflictId"}, {"$ref": "#/$defs/ArchiveId"}, {"$ref": "#/$defs/AnnotationId"}, {"$ref": "#/$defs/SourceId"}, {"$ref": "#/$defs/CompileProfileId"}, {"$ref": "#/$defs/StyleMapId"}
